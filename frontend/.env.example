# API Base URL
# Development:     /api  (uses Vite proxy)
# Production:      /api  (uses reverse proxy / same-origin)
# Desktop:         http://localhost:5001  (direct backend connection)
VITE_API_BASE_URL=/api

# Dev server host (development only)
VITE_HOST=0.0.0.0

# Dev server port (development only)
VITE_PORT=5174

# Proxy target (development only, used when VITE_API_BASE_URL=/api)
VITE_PROXY_TARGET=http://127.0.0.1:5001
