# API Base URL
# Development (direct):  http://localhost:5001  (CORS-enabled web backend)
# Development (proxy):   /api  (uses Vite proxy, see VITE_PROXY_TARGET)
# Production:            /api  (uses reverse proxy / same-origin)
# Desktop (Tauri):       http://localhost:5001  (direct backend connection)
# VITE_API_URL takes precedence over VITE_API_BASE_URL.
VITE_API_URL=http://localhost:5001
# VITE_API_BASE_URL=/api

# Dev server host (development only)
VITE_HOST=0.0.0.0

# Dev server port (development only)
VITE_PORT=5174

# Proxy target (development only, used when VITE_API_BASE_URL=/api)
VITE_PROXY_TARGET=http://127.0.0.1:5001
