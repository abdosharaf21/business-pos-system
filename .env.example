# Flask Environment
FLASK_ENV=development

# Security (REQUIRED — set strong values in production)
SECRET_KEY=
JWT_SECRET_KEY=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_system
DB_USER=root
DB_PASSWORD=
DB_POOL_NAME=pos_pool
DB_POOL_SIZE=5

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5001

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# Frontend (used by Vite — set in frontend/.env)
# VITE_API_BASE_URL=/api
# VITE_HOST=0.0.0.0
# VITE_PORT=5174
# VITE_PROXY_TARGET=http://127.0.0.1:5001
