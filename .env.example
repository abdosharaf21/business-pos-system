# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.
# =============================================================================

# Flask environment: development | production
FLASK_ENV=development

# =============================================================================
# Security (REQUIRED)
# =============================================================================
# Secret key for Flask session signing (generate a random string)
SECRET_KEY=

# Secret key for JWT token signing (generate a random string)
JWT_SECRET_KEY=

# =============================================================================
# Database Configuration
# =============================================================================

# MySQL server hostname or IP address
DB_HOST=localhost

# MySQL server port
DB_PORT=3306

# Database name
DB_NAME=pos_system

# Database username
DB_USER=root

# Database password (never commit real values to version control)
DB_PASSWORD=

# Connection pool name identifier
DB_POOL_NAME=pos_pool

# Maximum number of connections in the pool
DB_POOL_SIZE=5
