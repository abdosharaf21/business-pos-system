# Flask Environment
FLASK_ENV=development

# Security (REQUIRED — set strong values in production)
SECRET_KEY=
JWT_SECRET_KEY=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_system
DB_USER=root
DB_PASSWORD=
DB_POOL_NAME=pos_pool
DB_POOL_SIZE=5

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5001

# CORS — comma-separated list of allowed origins
# Web deployments: list the exact public origin(s), e.g. https://pos.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
# Expand localhost origins with LAN-IP variants (desktop convenience)
CORS_EXPAND_LAN=true

# Security headers — config-driven per environment
SECURITY_HEADERS_ENABLED=true
# CSP must be off while the Vite dev server (HMR websocket) serves the SPA;
# enable in production, and override CSP_POLICY to match the app's needs.
CSP_ENABLED=false
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'
# Enable ONLY when the server is reachable over HTTPS
HSTS_ENABLED=false

# Frontend (used by Vite — set in frontend/.env)
# VITE_API_BASE_URL=/api
# VITE_HOST=0.0.0.0
# VITE_PORT=5174
# VITE_PROXY_TARGET=http://127.0.0.1:5001
